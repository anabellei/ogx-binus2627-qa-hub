# --- Auth (Google OAuth client, type "Web application") ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Your MAIN Drive folder (the one that contains the GV and GTa folders) ---
# ID from the URL: drive.google.com/drive/folders/<THIS_PART>
# The app also stores its settings file here (_qa-hub-settings.json) and creates "Audit/" here.
DRIVE_ROOT_FOLDER_ID=

# --- Optional ---
# Who may sign in. Leave both empty to allow any Google account (they still only see what Google lets them open).
# Exact emails and/or whole domains, comma separated:
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
# First run only (pre-fills a "GV" product). After you save Settings this is ignored, so you can delete it.
TRACKER_SHEET_ID=

# Set to true to run with fake data, no Google needed
DEMO_MODE=false
