# --- Auth (Google OAuth client, type "Web application") ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Your MAIN Drive folder (the one that contains the GV and GTa folders) ---
# ID from the URL: drive.google.com/drive/folders/<THIS_PART>
# The app also stores its settings file here (_qa-hub-settings.json) and creates "Audit/" here.
DRIVE_ROOT_FOLDER_ID=

# --- Optional ---
# Only these email domains may sign in (comma separated)
ALLOWED_EMAIL_DOMAINS=
# Convenience for the very first run only: pre-fills a "GV" product. After that, manage products in Settings.
TRACKER_SHEET_ID=

# Set to true to run with fake data, no Google needed
DEMO_MODE=false
